## 生产环境(阿里云 OSS 静态托管,前面没有 nginx)
NODE_ENV = 'production'

# 直连 API 网关的绝对地址。OSS 无反向代理,不能再用 /web-api 相对路径。
# 网关按二级服务前缀路由:/auth → auth-service,/user → user-service
VITE_APP_BASE_API = 'https://api.prod.structured.cn'

# OAuth2 授权端点走网关的 /auth 前缀,StripPrefix(1) 后到 auth-service /oauth2/*
VITE_OAUTH_BASE_URL = 'https://api.prod.structured.cn/auth'

# TODO 待 auth-service 提供正式注册的 client。当前值仅为占位,线上换不到 token。
VITE_OAUTH_CLIENT_ID = 'test-client'
VITE_OAUTH_CLIENT_SECRET = 'secret'

# hash 路由 + OSS 子目录 /sso/,须与 auth-service 注册的 redirect-uri 完全一致
VITE_OAUTH_REDIRECT_URI = 'https://structure-web.cn-beijing.taihangtop.cn/sso/#/oauth2/callback'

VITE_OAUTH_SCOPE = 'read write'
VITE_OAUTH_AUTHORIZE_ENDPOINT = '/oauth2/authorize'
VITE_OAUTH_TOKEN_ENDPOINT = '/oauth2/token'
VITE_OAUTH_INTROSPECT_ENDPOINT = '/oauth2/introspect'
VITE_OAUTH_USER_INFO_ENDPOINT = '/oauth2/userinfo'

VITE_SOCIAL_APP_ID = 'default-app'
