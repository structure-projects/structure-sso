## 开发环境
NODE_ENV = 'development'

# 应用端口
VITE_APP_PORT = 17103

# API 前缀:dev 为相对路径,由下面的 proxy 转发
VITE_APP_BASE_API = '/web-api'

# 代理目标:默认直连 auth-service,不含 9000 即为直连模式
# 联调网关时改为 http://localhost:9000/
VITE_PROXY_TARGET = 'http://localhost:18103/'
VITE_PROXY_TARGET_USER = 'http://localhost:18102/'

# OAuth2 配置
VITE_OAUTH_BASE_URL = 'http://localhost:18103'
VITE_OAUTH_CLIENT_ID = 'test-client'
VITE_OAUTH_CLIENT_SECRET = 'secret'
VITE_OAUTH_REDIRECT_URI = 'http://localhost:17103/#/oauth2/callback'
VITE_OAUTH_SCOPE = 'read write'
VITE_OAUTH_AUTHORIZE_ENDPOINT = '/oauth2/authorize'
VITE_OAUTH_TOKEN_ENDPOINT = '/oauth2/token'
VITE_OAUTH_INTROSPECT_ENDPOINT = '/oauth2/introspect'
VITE_OAUTH_USER_INFO_ENDPOINT = '/oauth2/userinfo'

# 社交登录
VITE_SOCIAL_APP_ID = 'default-app'
