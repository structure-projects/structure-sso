## 测试环境(阿里云 OSS 静态托管,产物落在 test/sso/ 前缀)
NODE_ENV = 'production'

# TODO 测试网关域名未确定,以下为占位值,确定后替换
VITE_APP_BASE_API = 'https://api.test.structured.cn'
VITE_OAUTH_BASE_URL = 'https://api.test.structured.cn/auth'

# TODO 待 auth-service 提供测试环境注册的 client
VITE_OAUTH_CLIENT_ID = 'test-client'
VITE_OAUTH_CLIENT_SECRET = 'secret'

# TODO 域名待定。注意测试环境产物在 test/sso/ 子目录,base 与此处须一致
VITE_OAUTH_REDIRECT_URI = 'https://structure-web.cn-beijing.taihangtop.cn/test/sso/#/oauth2/callback'

VITE_OAUTH_SCOPE = 'read write'
VITE_OAUTH_AUTHORIZE_ENDPOINT = '/oauth2/authorize'
VITE_OAUTH_TOKEN_ENDPOINT = '/oauth2/token'
VITE_OAUTH_INTROSPECT_ENDPOINT = '/oauth2/introspect'
VITE_OAUTH_USER_INFO_ENDPOINT = '/oauth2/userinfo'

VITE_SOCIAL_APP_ID = 'default-app'
